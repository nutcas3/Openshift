# Secrets for the CI namespace. Copy and fill; never commit real values.
#
#   cp secrets.example.env secrets.env
#   oc create secret generic ci-secrets --from-env-file=secrets.env -n ci-pipelines

# --- SonarQube ---
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarqube.example.com

# --- ACS / StackRox ---
# Central API endpoint (host:port) and an API token with image scan rights.
ROX_CENTRAL_ENDPOINT=central.stackrox.svc:443
ROX_API_TOKEN=

# --- Registry push creds (cosign signature upload) ---
# Create separately as a dockerconfigjson secret named registry-push:
#   oc create secret docker-registry registry-push \
#     --docker-server=image-registry.openshift-image-registry.svc:5000 \
#     --docker-username=... --docker-password=... -n ci-pipelines
# (or link the pipeline-ci SA's push token)

# --- Tekton Chains signing key ---
# cosign generate-key-pair k8s://openshift-pipelines/signing-secrets
# creates signing-secrets (cosign.key, cosign.pub, cosign.password) itself.
# The cosign task reads COSIGN_PASSWORD from that secret.
