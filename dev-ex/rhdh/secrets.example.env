# Copy to secrets.env and fill in. Never commit secrets.env.
#
#   cp secrets.example.env secrets.env
#   oc create secret generic rhdh-secrets --from-env-file=secrets.env -n rhdh

# Public URL RHDH is served at, e.g. https://rhdh.apps.<cluster-domain>
RHDH_BASE_URL=

# Backend-to-backend / cookie signing secret (any long random string)
BACKEND_SECRET=

# GitHub App credentials — used for publish:github, publish:github:pull-request,
# catalog ingestion, and GitHub sign-in.
# Create at https://github.com/organizations/<org>/settings/apps
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the full PEM including BEGIN/END lines. The env-file format keeps
# newlines if you escape them as \n, or use --from-literal with a file.
GITHUB_APP_PRIVATE_KEY=

# Webhook secret configured on the GitHub App, plus the smee.io channel ID
# relaying webhooks to the cluster (or your own relay endpoint).
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_CHANNEL=

# GitHub org that owns the templates repo and receives new app repos.
GITHUB_ORG=
# This repo's name and default branch (for catalog location targets).
DEV_EX_REPO=dev-ex
DEV_EX_BRANCH=main
